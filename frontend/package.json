{
  "name": "warriors-gym-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22" },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:parents": "vite build --mode parents",
    "preview": "vite preview",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "ota:keygen": "node scripts/ota-keygen.mjs",
    "ota:publish": "npm run build && node scripts/ota-publish.mjs",
    "ota:publish:parents": "npm run build:parents && node scripts/ota-publish-parents.mjs",
    "ota:stage": "node scripts/ota-stage.mjs",
    "ota:apply-staged": "node scripts/ota-apply-staged.mjs",
    "ota:verify:dual-local": "npm run build && npm run build:parents && node scripts/ota-dual-local-check.mjs",
    "android:prepare:parents": "node scripts/prepare-parent-android-workspace.mjs",
    "test": "node --experimental-vm-modules --test tests/*.test.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capawesome/capacitor-live-update": "^8.4.2",
    "axios": "^1.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.16.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@vitejs/plugin-react": "^4.3.1",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vite": "^5.4.1"
  }
}
